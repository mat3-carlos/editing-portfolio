---
const socials = [
  { label: "Twitter", href: "https://x.com/carlosmate__" },
  { label: "Email", href: "mailto:carlosmateangulo@gmail.com" },
];
---

<footer id="contacto" class="scroll-mt-20 border-t border-border">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="font-mono text-xs tracking-wide text-muted-foreground uppercase">¿Hablamos?</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
          Cuéntame tu proyecto y le damos forma.
        </h2>
        <a
          href="mailto:hola@carlosmate.es"
          class="mt-6 inline-flex items-center gap-2 rounded-md bg-primary px-5 py-2.5 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90"
        >
          carlosmateangulo@gmail.com
        </a>
      </div>

      <div class="flex gap-6 text-sm text-muted-foreground">
        {socials.map((s) => (
          <a href={s.href} class="transition-colors hover:text-foreground">{s.label}</a>
        ))}
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-2 border-t border-border pt-6 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} Carlos Maté </p>
      <a href="https://carlosmate.es" class="transition-colors hover:text-foreground">carlosmate.es</a>
    </div>
  </div>
</footer>
