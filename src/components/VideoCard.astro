---
interface Props {
  title: string;
  category: string;
  /** Path to a local muted preview clip, e.g. "/videos/brand-x.mp4" */
  videoSrc?: string;
  /** Poster image shown before hover / while the clip loads */
  poster?: string;
  /** Tailwind gradient classes used as a placeholder when there's no media yet */
  gradient?: string;
  /** Fade-up reveal delay in ms, for staggering a grid of cards */
  delay?: number;
}

const {
  title,
  category,
  videoSrc,
  poster,
  gradient = "from-primary/25 via-accent/15 to-transparent",
  delay = 0,
} = Astro.props;
---

<article
  class="video-card group reveal relative aspect-video overflow-hidden rounded-lg border border-border bg-card"
  style={`--reveal-delay: ${delay}ms`}
  data-video-src={videoSrc}
  data-title={title}
  data-category={category}
  role={videoSrc ? "button" : undefined}
  tabindex={videoSrc ? 0 : undefined}
>
  {
    videoSrc ? (
      <video
        class="h-full w-full object-cover"
        src={videoSrc}
        poster={poster}
        muted
        loop
        playsinline
        preload="metadata"
      />
    ) : (
      <div class={`h-full w-full bg-gradient-to-br ${gradient}`} />
    )
  }

  <div
    class="pointer-events-none absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-black/80 via-black/10 to-transparent p-4 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
  >
    <p class="font-mono text-[11px] tracking-wide text-white/70 uppercase">{category}</p>
    <h3 class="text-sm font-medium text-white">{title}</h3>
  </div>

  <div
    class="pointer-events-none absolute right-3 top-3 grid size-8 place-items-center rounded-full bg-white/10 text-white opacity-0 backdrop-blur-sm transition-opacity duration-300 group-hover:opacity-100"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5">
      <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
    </svg>
  </div>
</article>

<script>
  // Autoplay the preview clip on hover, pause + rewind on leave.
  // Click / Enter opens the full-size lightbox with sound.
  document.querySelectorAll<HTMLElement>(".video-card").forEach((card) => {
    const video = card.querySelector("video");
    if (!video) return;

    card.classList.add("cursor-pointer");

    card.addEventListener("mouseenter", () => {
      video.currentTime = 0;
      video.play().catch(() => {});
    });
    card.addEventListener("mouseleave", () => {
      video.pause();
    });

    const open = () => {
      video.pause();
      window.dispatchEvent(
        new CustomEvent("open-lightbox", {
          detail: {
            src: card.dataset.videoSrc,
            title: card.dataset.title,
            category: card.dataset.category,
          },
        })
      );
    };

    card.addEventListener("click", open);
    card.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        open();
      }
    });
  });
</script>
