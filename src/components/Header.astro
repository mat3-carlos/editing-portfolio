---
import ThemeToggle from "./ThemeToggle.astro";

const links = [
  { href: "#reel", label: "Reel" },
  { href: "#proyectos", label: "Proyectos" },
  { href: "#sobre-mi", label: "Sobre mí" },
  { href: "#contacto", label: "Contacto" },
];
---

<header class="sticky top-0 z-50 border-b border-border bg-background/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <a href="/" class="flex items-baseline gap-1.5 font-mono text-sm font-medium">
      <span>carlosmate</span>
      <span class="rounded-sm bg-accent/15 px-1.5 py-0.5 text-[11px] font-medium text-accent">Video Editor</span>
    </a>

    <nav class="hidden items-center gap-8 text-sm text-muted-foreground md:flex">
      {links.map((link) => (
        <a href={link.href} class="transition-colors hover:text-foreground">
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="https://carlosmate.es"
        class="hidden rounded-md border border-border px-3 py-1.5 text-xs text-muted-foreground transition-colors hover:text-foreground hover:border-ring sm:inline-block"
      >
        ← carlosmate.es
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>
